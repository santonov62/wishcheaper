{
  "name": "Wishcheaper bookmark",
  "version": "1.0",
  "description": "Build an Extension!",
  "permissions": [
    "storage",
    "declarativeContent",
    "http://*/*",
    "https://*/*",
    "https://vk.com/js/api/openapi.js"
  ],
  "content_scripts": [
  {
    "matches": [
      "<all_urls>"
    ],
    "js": ["openapi.js", "content.js"]
  }
],
  "web_accessible_resources": ["https://vk.com/js/api/openapi.js"],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/16.png",
      "64": "images/64.png",
      "48": "images/48.png",
      "128": "images/128.png"
    }
  },
  "icons": {
    "16": "images/16.png",
    "64": "images/64.png",
    "48": "images/48.png",
    "128": "images/128.png"
  },
  "manifest_version": 2
}